# Copy to .env before running. Never commit real values.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# PostgreSQL. Docker compose creates this user and the "trading" database automatically;
# for a locally installed PostgreSQL run ./scripts/setup-local-db.sh once to create them.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=trading
DB_PASSWORD=trading

# Redis cache for market data
REDIS_HOST=localhost

# Optional: free CoinGecko demo key raises the rate limit (https://www.coingecko.com/en/api)
COINGECKO_API_KEY=

# Live price stream (free, no key). US-hosted servers: wss://stream.binance.us:9443/ws/!miniTicker@arr
LIVE_PRICES_URL=wss://stream.binance.com:9443/ws/!miniTicker@arr

STRIPE_API_KEY=sk_test_...
RAZORPAY_API_KEY=rzp_test_...
RAZORPAY_API_SECRET=...

# Optional: only needed for 2FA and password-reset emails (e.g. a Gmail address + app password)
MAIL_USERNAME=
MAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173
